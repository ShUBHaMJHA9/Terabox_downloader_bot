FREE_FILE_LIFETIME=1800       # 30 minutes
FREE_HOURLY_LIMIT=10
MAX_FREE_SIZE=2097152000      # 2GB

### ================================
### DATABASE CONFIGURATION
### ================================
# SQLite (Local)
# DATABASE_PATH=./db/bot_database.sqlite

# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# PostgreSQL - Supabase
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# PostgreSQL - Tembo
TEMBO_HOST=your-host.data-1.region.tembo.io
TEMBO_PORT=5432
TEMBO_NAME=postgres
TEMBO_USER=postgres
TEMBO_PASSWORD=your_password

# LibSQL - Turso
TURSO_DATABASE_URL=libsql://your-database.aws-region.turso.io
TURSO_AUTH_TOKEN=your_auth_token

### ================================
### LOGGING CONFIGURATION
### ================================
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log

### ================================
### FEATURE FLAGS
### ================================
ENABLE_CHANNEL_FORWARDING=true
FORWARD_CHANNEL_ID=-1002623172869
ENABLE_FILE_CACHING=true
CACHE_DIRECTORY=./cache
DEBUG=True

### ================================
### TIMEOUT & LIMITS
### ================================
DOWNLOAD_TIMEOUT=3600
UPLOAD_TIMEOUT=3600
RETRIES=3

# File size limits (in bytes)
MAX_FILE_SIZE=524288000              # 500MB default
PREMIUM_MAX_FILE_SIZE=2147483648    # 2GB for premium users

# Auto-delete settings
AUTO_DELETE_AFTER_UPLOAD=true        # Delete file after upload
AUTO_DELETE_DELAY=300                # 5 minutes delay before delete (seconds)

# Upload optimization
UPLOAD_CHUNK_SIZE=1048576            # 1MB chunks for faster upload
MAX_CONCURRENT_UPLOADS=3             # Max concurrent upload tasks

